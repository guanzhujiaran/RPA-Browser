# =============================================================================
# RPA-Browser 环境变量示例
# -----------------------------------------------------------------------------
# 用法：复制为 .env.dev（本地开发）或 .env.prod（生产/容器）后按需修改
#   cp .env.example .env.dev
#
# 加载顺序（见 app/config.py）：.env.prod 先加载、.env.dev 后加载，后者覆盖前者；
# MCP 配置（app/mcp/config.py）读取同一组文件，但要求 RPA_MCP_ 前缀。
# 键名 = Settings 字段名（pydantic-settings 大小写不敏感）；
# 布尔值写 true / false；列表类字段（如 GITHUB_PROXY_URLS）需写成 JSON 数组。
# ⚠️ 容器部署时大部分变量由 docker-compose.yml 的 environment 注入，本文件主要用于
#    非 Docker 本地运行；同一变量以进程环境变量优先级最高。
# =============================================================================


# ============================== 1. 必填项 ==============================
# 运行模式：dev / prod（必填，无默认值）。影响默认日志级别、MCP 端点是否挂载等
RUNNING_MODE=dev

# 主库连接串（必填）。SQLAlchemy async 驱动
mysql_browser_info_url=mysql+aiomysql://127.0.0.1:10000/BiliRPADB?user=root&password=your_mysql_password


# ============================== 2. 服务与接口 ==============================
# 对外接口基础路径（默认 /api）；Docker 环境为 /api/v1/rpa
controller_base_path=/api/v1/rpa
# 管理端接口前缀（默认 /api/admin/rpa）
admin_base_path=/api/admin/rpa
# 本服务标识：写入推送告警标题 [服务名@地址]，缺省自动取容器/主机 hostname
SERVER_NAME=rpa-browser
SERVER_ADDRESS=
# be-message 服务地址：管理员身份判定（GET /api/v1/message/admin/me）
# 默认 http://be-message-service:18739；本地开发改为 127.0.0.1 端口
message_service_url=http://127.0.0.1:18739

# JWT 解析参数（网关透传的身份头同样会用到）
jwt_algorithm=HS256
jwt_expire_minutes=10080


# ============================== 3. 日志 ==============================
# 业务日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# 不填时按运行模式推导：dev -> INFO，prod -> WARNING
LOG_LEVEL=INFO


# ============================== 4. 消息队列（RPC） ==============================
# RabbitMQ 连接串：RPC 调用 be-bilibili-crawler、操作日志异步落库、后端串行调度都走它
rabbitmq_url=amqp://admin:your_rabbitmq_password@127.0.0.1:5672/?heartbeat=180


# ============================== 5. 代理 ==============================
# 可访问外网的代理（拉取 Chromium 等）；host.docker.internal 指向宿主机
proxy_server_url=http://127.0.0.1:10809
# 浏览器出口代理的**运行时兜底**：只写 ip:port，不带协议（httpx 的 all:// 会自动适配）
# 仅供启动浏览器时兜底使用，不会写入指纹/数据库；指纹里只保存用户显式配置的代理
default_proxy_server=127.0.0.1:3128
# 代理绕过列表的**运行时兜底**：命中的主机直连、不走代理，逗号或分号分隔。
# 只支持主机名/IP（可写 *.example.com），不能写完整 URL。
# 单个浏览器可在指纹里单独配置 proxy_bypass，配置了就优先用它；本项同样不落库。
# browser_proxy_bypass=*.bilibili.com,127.0.0.1
# 拉取 Chromium 的 GitHub 加速镜像列表（JSON 数组，首个 null 表示直连优先）
# 留空则使用内置的长列表，仅在需要自定义镜像顺序时配置
# GITHUB_PROXY_URLS=["http://127.0.0.1:7890","https://gh-proxy.com/"]

# Gemini API Key（指纹生成等可选能力使用；不需要时保持默认占位值）
GEMINI_API_KEY=NotNecessary


# ============================== 6. 推送告警 ==============================
# 全局推送渠道配置（JSON 字符串，与 be-message-service / be-bilibili-crawler 共用；
# 无 per-user 配置时的兜底）。字段见 bili_common.models.push.PushChannelConfig
MESSAGE_CONFIG='{"pushme_key":"","pushme_url":"https://push.i-i.me","push_plus_token":"","push_plus_url":"https://www.pushplus.plus/send","smtp_server":"smtp.example.com:465","smtp_ssl":"true","smtp_email":"","smtp_password":"","smtp_name":"rpa-browser","tg_bot_token":"","tg_user_id":"","tg_api_host":"","tg_proxy_host":"","tg_proxy_port":""}'
# 一言接口（推送内容点缀）
hitokoto_api_url=https://v1.hitokoto.cn


# ============================== 7. Casdoor 支付对账 ==============================
# 空 = 不启用对账。使用应用 client 凭证（Basic auth）查询支付记录
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
casdoor_verify_timeout=5.0


# ============================== 8. 浏览器启动与虚拟显示 ==============================
# Chromium 可执行文件目录（默认 app/chrome，首次启动会自动下载）
# chromium_executable_dir=/app/app/chrome
# 服务器无物理显示器：用 Xvfb 提供虚拟屏幕，浏览器仍是完整有头模式
xvfb_enabled=true
xvfb_display=:99
xvfb_screen=1920x1080x24

# 单个浏览器上下文最大页面数
browser_max_pages_per_context=10


# ============================== 9. 内存准入与并发护栏 ==============================
# 启动浏览器前检查系统可用内存，不足则排队（VIP 队列优先）
browser_launch_queue_enabled=true
browser_launch_min_available_memory_mb=1024
browser_launch_reserved_memory_mb=768
browser_launch_admit_cooldown_ms=1000
browser_launch_queue_tick_interval_ms=1000
# 排队最大等待（秒），0 = 不限
browser_launch_queue_max_wait_time=600
# 排队时长估算（ETA）采样参数
browser_launch_eta_sample_window=20
browser_launch_eta_min_samples=3
# 按实测 PSS 自适应校准预留额度
browser_memory_estimate_enabled=true
browser_memory_scan_interval=15
browser_memory_post_launch_delay=10
browser_memory_sample_window=20
browser_memory_min_samples=3
browser_memory_safety_factor=1.1
browser_memory_min_sample_mb=64
# 系统内存使用率红线（%），超过一律不放行
browser_launch_max_memory_percent=90.0
# 同时存在的浏览器实例上限，0 = 仅按内存限制
browser_max_concurrent_instances=0


# ============================== 10. 会话生命周期 ==============================
browser_session_auto_cleanup=true
# 空闲超过该时长（秒）关实例出池；注释掉 = 用程序默认值（240）
# browser_session_max_idle_time=240
browser_session_cleanup_interval=60
# 会话过期时间（秒），留空 = 不过期
# browser_session_expiration_time=
# 闲置三级软着陆：须满足 degrade_after < suspend_after < max_idle_time，
# 且 suspend_after + terminate_grace <= 300（闲置到关实例不超过 5 分钟）
browser_stream_degrade_after=60
browser_stream_suspend_after=180
browser_session_terminate_grace=60
# 会话状态 SSE 心跳（秒），必须小于网关空闲超时（180s）
browser_session_sse_heartbeat_interval=15


# ============================== 11. WebRTC 视频流 ==============================
# 单会话最大观看者数，0 = 不限制（每增加一个观看者多编码一份 H264）
browser_webrtc_max_viewers=0
browser_webrtc_viewer_idle_timeout=60
browser_webrtc_viewer_reap_interval=20
browser_webrtc_idle_timeout=300
# 各清晰度档位（JPEG 质量 / 最大帧率 / 浏览器侧分辨率上限）
browser_stream_original_quality=100
browser_stream_original_max_fps=30
browser_stream_ultra_quality=90
browser_stream_ultra_max_fps=30
browser_stream_ultra_frame_max_width=1920
browser_stream_ultra_frame_max_height=1080
browser_stream_medium_quality=65
browser_stream_medium_max_fps=15
browser_stream_medium_frame_max_width=960
browser_stream_medium_frame_max_height=540
browser_stream_degrade_quality=50
browser_stream_degrade_max_fps=5
browser_stream_degrade_frame_max_width=640
browser_stream_degrade_frame_max_height=360


# ============================== 12. 工作流执行 ==============================
# 控制流（Loop / IfElse）最大嵌套深度
workflow_max_nesting_depth=10
# 同浏览器工作流排队等待执行权的最长时长（秒）
workflow_queue_timeout_seconds=1800
# 定时任务运行中的计费心跳间隔（秒）
workflow_billing_heartbeat_interval=300
# 僵尸运行收口：宽限期 + 扫描间隔（秒）
workflow_stale_run_grace_seconds=600
workflow_stale_run_reap_interval=300
# 停止宽限期兜底（秒）
workflow_stop_grace_seconds=30
workflow_stop_scan_interval=10
# Fork 上游自动同步扫描间隔（秒）
workflow_upstream_sync_interval=600
# 运行进度 SSE
workflow_run_sse_heartbeat_interval=15
workflow_run_progress_persist_interval=1.0
# 运行消息 detail 最大字符数，0 = 不裁剪（SSE 不落盘，默认不裁剪）
workflow_run_log_detail_max_length=0
# 容错熔断：一次运行中被 on_error=continue 跳过的失败步骤达到该数即判失败，0 = 关闭
workflow_tolerated_fail_failed_threshold=10
# 重启断点恢复
workflow_resume_on_startup=true
workflow_resume_max_count=3
workflow_resume_max_age_seconds=21600
# 运行结束是否回收浏览器：false = 只关页面，浏览器交给空闲回收（推荐）
workflow_release_browser_after_run=false


# ============================== 13. 审批开关 ==============================
# 执行类操作（跑工作流 / 定时计划）是否强制先过审批单；默认关闭
require_approval_enabled=false
# 公开到社区是否强制先过 publish 审批单；默认开启
require_publish_approval_enabled=true


# ============================== 14. 雪花 ID（对外资源 ID） ==============================
# epoch（秒级时间戳，默认 2026-01-01 00:00:00 UTC+8）
# worker_id 在多实例部署时必须互不相同，且各实体之间必须错开
# sequence_bits 变更会改变 ID 数值空间，仅限清库重建的环境调整
browser_id_epoch_sec=1767196800
browser_id_worker_id=4
browser_id_sequence_bits=4
action_id_epoch_sec=1767196800
action_id_worker_id=5
action_id_sequence_bits=4
workflow_id_epoch_sec=1767196800
workflow_id_worker_id=6
workflow_id_sequence_bits=4


# ============================== 15. 数据库迁移 ==============================
alembic_auto_migrate=true
alembic_upgrade_target=heads


# ============================== 16. 浏览器操作日志采集 ==============================
# 用户未单独设置时的服务端兜底值
action_log_default_enabled=false
action_log_max_payload_length=4000
# 保留天数，0 = 永久保留
action_log_default_retention_days=7
action_log_cleanup_interval=86400
# 日志投递走 RabbitMQ（投递失败自动回落同步直写），关闭即全同步直写
action_log_use_mq=true
action_log_mq_cooldown_seconds=30.0


# ============================== 17. 其他 ==============================
# 业务时区（签到 / 日统计自然日判定兜底）
app_timezone=Asia/Shanghai
# 每月 1 号 00:05 清零上月剩余时长
duration_monthly_reset_enabled=true


# ============================== 18. MCP 端点（RPA_MCP_ 前缀，全部可选） ==============================
# 是否挂载 MCP 端点：不设置时 dev 开启、prod 关闭
# RPA_MCP_ENABLED=
RPA_MCP_MOUNT_SUFFIX=/mcp
RPA_MCP_POLL_INTERVAL=1.5
RPA_MCP_MAX_WAIT_SECONDS=300
RPA_MCP_PAYLOAD_MAX_CHARS=1200
# 额外排除暴露的 operationId（逗号分隔）
RPA_MCP_EXCLUDE_OPERATIONS=
